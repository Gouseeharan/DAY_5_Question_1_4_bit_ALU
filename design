module alu_4bit( input [3:0]a, [3:0]b, [2:0]op, output reg [3:0]result, reg zero );
always @(*) begin
  case ( op )
  3'b000: result = a + b;
  3'b001: result = a - b;
  3'b010: result = a & b;
  3'b011: result = a | b;
  3'b100: result = a ^ b;
  3'b101: result = ~ a;
  3'b110: result = a << 1;
  3'b111: result = a >> 1;
endcase
if ( result == 0) 
zero = 1'b1;
else
zero = result;
end
endmodule
